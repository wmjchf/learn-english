PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=app_starter

JWT_SECRET=dev-change-me
JWT_ACCESS_EXPIRES=7d
REFRESH_EXPIRES_DAYS=30

# true=不发真实短信，固定验证码 SMS_DEV_CODE
SMS_DEV_MODE=true
SMS_DEV_CODE=123456
SMS_REVIEW_PHONE=
SMS_REVIEW_CODE=888888

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# 百炼 DashScope（OpenAI 兼容；勿提交真实 Key）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_AI_MODEL=qwen3.8-27b
LLM_TIMEOUT_MS=180000
# Qwen3 思考链：成文请保持 false
LLM_ENABLE_THINKING=false
GENERATE_DAILY_QUOTA=1
LESSON_RETRY_MAX=2

# 百炼 Qwen-TTS 朗读（复用 DASHSCOPE_API_KEY）
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_LANGUAGE_TYPE=English
